--[[
  button-bell.qplug

  PKE~Button-Bell - a Q-SYS Designer plugin that plays a looped bell/ring
  audio file for as long as an input/button is held true (with a
  configurable minimum play time), adds reverb, and lets each theater pick
  from 5 built-in default sounds or supply their own custom audio file.

  IMPORTANT - Q-SYS plugin architecture note:
  Third-party Lua plugins are normally CONTROL-ONLY, but Q-SYS Designer
  does support a documented mechanism for a plugin to embed native DSP
  sub-components directly inside itself via GetComponent(), which then
  exposes their audio connectors as this block's own audio pins. This
  plugin uses that mechanism to embed a native Audio File Player and a
  native Reverb, so the block itself now has a real audio output you can
  wire straight to an amp/zone - no separate components required.

  NOTE ON RISK: the exact component "Type" identifiers accepted by
  GetComponent() are determined by Q-SYS Designer's internal component
  library and are NOT all publicly enumerated. If Designer reports an
  error such as "unknown component type" when this plugin is loaded,
  please share the EXACT error text - it will tell us the type string
  Designer actually expects, and the two Type values below (currently
  "audio_file_player" and "reverb") can be corrected immediately. If no
  embeddable audio-player/reverb type exists at all, this plugin can be
  reverted to the external-named-component approach documented in a
  previous version of PLUGIN_README.md as a guaranteed-working fallback.

  Author: DHPKE
--]]

PluginInfo = {
  Name = "PKE~Button-Bell",
  Version = "1.0.0",
  Id = "qsys.pke.button-bell",
  Description = "Plays a looped bell/ring sound while an input is true, with minimum play time and reverb. Choose from 5 built-in sounds or a custom file.",
  ShowDebug = true,
}

local DEBUG_CHOICES = { "None", "All" }

local TRIGGER_OUTPUT_TYPE_CHOICES = { "Boolean", "Integer", "String" }

local DEFAULT_SOUND_CHOICES = {
  "Default 1 - Classic Bell",
  "Default 2 - School Bell",
  "Default 3 - Soft Chime",
  "Default 4 - Theater Bell",
  "Default 5 - Buzzer",
  "Custom",
}

-- Maps the friendly dropdown choice to the actual audio file name expected
-- in the Audio File Player component's file list / core media library.
-- Rename these to match whatever you place in the Core's Media Library
-- (Design Media / Core Media Files) if your file names differ.
local DEFAULT_SOUND_FILES = {
  ["Default 1 - Classic Bell"] = "PKE_Bell_Classic.wav",
  ["Default 2 - School Bell"] = "PKE_Bell_School.wav",
  ["Default 3 - Soft Chime"] = "PKE_Bell_Chime.wav",
  ["Default 4 - Theater Bell"] = "PKE_Bell_Theater.wav",
  ["Default 5 - Buzzer"] = "PKE_Bell_Buzzer.wav",
}

function GetColor(props)
  return { 178, 34, 34 } -- firebrick
end

function GetPrettyName(props)
  return "PKE~Button-Bell"
end

function GetProperties()
  return {
    { Name = "Sound Selection", Type = "enum", Choices = DEFAULT_SOUND_CHOICES, Value = "Default 1 - Classic Bell" },
    { Name = "Custom File Name", Type = "string", Value = "" },
    { Name = "Minimum Play Time (ms)", Type = "integer", Min = 0, Max = 600000, Value = 1000 },
    { Name = "Reverb Mix Default (%)", Type = "integer", Min = 0, Max = 100, Value = 20 },
    { Name = "Trigger Output Type", Type = "enum", Choices = TRIGGER_OUTPUT_TYPE_CHOICES, Value = "Boolean" },
    { Name = "Trigger On Time (ms)", Type = "integer", Min = 0, Max = 600000, Value = 1000 },
    { Name = "Debug Print", Type = "enum", Choices = DEBUG_CHOICES, Value = "None" },
  }
end

function RectifyProperties(props)
  props["Custom File Name"].IsHidden = (props["Sound Selection"].Value ~= "Custom")
  return props
end

-- Embeds a native Audio File Player and native Reverb directly inside this
-- plugin. Q-SYS Designer exposes their audio connectors automatically as
-- this block's own audio pins (audio in on the Player side is unused here
-- since we only play local files; the Reverb's audio output becomes this
-- plugin's audio output pin, ready to wire to an amp/zone/gain block).
-- See the architecture note at the top of this file for the caveat on
-- these Type strings.
function GetComponent(props)
  return {
    { Name = "Player", Type = "audio_file_player" },
    { Name = "Reverb", Type = "reverb" },
  }
end

function GetControls(props)
  return {
    { Name = "input", ControlType = "Button", ButtonType = "Momentary", UserPin = true, PinStyle = "Input" },
    { Name = "active", ControlType = "Indicator", IndicatorType = "Led", UserPin = true, PinStyle = "Output" },
    { Name = "status_text", ControlType = "Text", UserPin = true, PinStyle = "Output" },
    { Name = "min_playtime_ms", ControlType = "Text", UserPin = true, PinStyle = "Input" },
    { Name = "reverb_mix", ControlType = "Knob", ControlUnit = "Percent", Min = 0, Max = 100, UserPin = true, PinStyle = "Input" },
    { Name = "sound_select", ControlType = "Text", ControlUnit = "List", UserPin = true, PinStyle = "Input" },
    { Name = "custom_file_name", ControlType = "Text", UserPin = true, PinStyle = "Input" },
    { Name = "stop_now", ControlType = "Button", ButtonType = "Trigger", UserPin = true, PinStyle = "Input" },
    { Name = "trigger_output_type", ControlType = "Text", ControlUnit = "List", UserPin = true, PinStyle = "Input" },
    { Name = "trigger_on_time_ms", ControlType = "Text", UserPin = true, PinStyle = "Input" },
    { Name = "trigger_output", ControlType = "Text", UserPin = true, PinStyle = "Output" },
  }
end

function GetControlLayout(props)
  local layout = {}
  local graphics = {}
  local yPos = 0
  local pageWidth = 260

  table.insert(graphics, {
    Type = "GroupBox",
    Text = "PKE~Button-Bell",
    Fill = { 102, 102, 102 },
    CornerRadius = 8,
    StrokeWidth = 2,
    Position = { 0, yPos },
    Size = { pageWidth, 300 },
  })
  -- Leave enough vertical clearance below the GroupBox header/title bar
  -- (the header text itself is drawn in roughly the top ~22px of the box)
  -- so the first row of controls doesn't overlap/cut off the title text.
  yPos = yPos + 26

  layout["status_text"] = {
    PrettyName = "Status~Status",
    Style = "Text",
    Color = { 255, 255, 255 },
    Position = { 10, yPos },
    Size = { 180, 16 },
  }
  layout["active"] = {
    PrettyName = "Status~Active",
    Style = "Indicator",
    Position = { 200, yPos },
    Size = { 16, 16 },
  }
  yPos = yPos + 24

  layout["input"] = {
    PrettyName = "Control~Input / Button",
    Style = "Button",
    ButtonStyle = "Momentary",
    Legend = "RING",
    Color = { 0, 255, 0 },
    Position = { 10, yPos },
    Size = { 110, 24 },
  }
  layout["stop_now"] = {
    PrettyName = "Control~Force Stop",
    Style = "Button",
    ButtonStyle = "Trigger",
    Legend = "STOP",
    Color = { 255, 80, 80 },
    Position = { 130, yPos },
    Size = { 110, 24 },
  }
  yPos = yPos + 32

  layout["sound_select"] = {
    PrettyName = "Sound~Sound Selection",
    Style = "ComboBox",
    Choices = DEFAULT_SOUND_CHOICES,
    Position = { 10, yPos },
    Size = { 240, 16 },
  }
  yPos = yPos + 24

  layout["custom_file_name"] = {
    PrettyName = "Sound~Custom File Name",
    Style = "Textbox",
    Position = { 10, yPos },
    Size = { 240, 16 },
  }
  yPos = yPos + 24

  layout["min_playtime_ms"] = {
    PrettyName = "Timing~Minimum Play Time (ms)",
    Style = "Textbox",
    Position = { 10, yPos },
    Size = { 100, 16 },
  }
  yPos = yPos + 24

  layout["reverb_mix"] = {
    PrettyName = "Sound~Reverb Mix (%)",
    Style = "Knob",
    Position = { 10, yPos },
    Size = { 60, 20 },
  }
  yPos = yPos + 30

  layout["trigger_output_type"] = {
    PrettyName = "Trigger Output~Output Type",
    Style = "ComboBox",
    Choices = TRIGGER_OUTPUT_TYPE_CHOICES,
    Position = { 10, yPos },
    Size = { 120, 16 },
  }
  yPos = yPos + 24

  layout["trigger_on_time_ms"] = {
    PrettyName = "Trigger Output~On Time (ms)",
    Style = "Textbox",
    Position = { 10, yPos },
    Size = { 100, 16 },
  }
  yPos = yPos + 24

  layout["trigger_output"] = {
    PrettyName = "Trigger Output~Output Value",
    Style = "Text",
    Color = { 255, 255, 255 },
    Position = { 10, yPos },
    Size = { 100, 16 },
  }

  return layout, graphics
end

-- =========================================================================
-- Runtime
-- =========================================================================
if Controls then
  local debugMode = Properties["Debug Print"].Value

  local function DebugPrint(msg)
    if debugMode == "All" then
      print("[PKE~Button-Bell] " .. tostring(msg))
    end
  end

  -- Resolve the two native components bundled into this plugin via
  -- GetComponent() above (Name = "Player" / Name = "Reverb"). Since these
  -- are embedded sub-components rather than externally-placed named
  -- components, they should always resolve - no manual naming required.
  local player = Component.New("Player")
  local reverb = Component.New("Reverb")

  if not player then
    DebugPrint("WARNING: Bundled Player sub-component failed to resolve - playback will not function.")
  end
  if not reverb then
    DebugPrint("WARNING: Bundled Reverb sub-component failed to resolve - reverb mix will not function.")
  end

  -- ------------------------------------------------------------------
  -- State
  -- ------------------------------------------------------------------
  local isPlaying = false
  local minTimeElapsed = true
  local releaseRequested = false
  local minTimer = Timer.New()
  local triggerOutputTimer = Timer.New()

  -- Seed default UI values from properties on load.
  Controls.min_playtime_ms.String = tostring(Properties["Minimum Play Time (ms)"].Value)
  Controls.reverb_mix.Value = Properties["Reverb Mix Default (%)"].Value
  Controls.sound_select.String = Properties["Sound Selection"].Value
  Controls.custom_file_name.String = Properties["Custom File Name"].Value
  Controls.trigger_output_type.String = Properties["Trigger Output Type"].Value
  Controls.trigger_on_time_ms.String = tostring(Properties["Trigger On Time (ms)"].Value)

  local function currentFileName()
    local sel = Controls.sound_select.String
    if sel == "Custom" or sel == "" then
      return Controls.custom_file_name.String
    end
    local mapped = DEFAULT_SOUND_FILES[sel]
    return mapped or sel
  end

  local function currentMinPlayMs()
    local v = tonumber(Controls.min_playtime_ms.String)
    if v == nil or v < 0 then
      return 0
    end
    return v
  end

  local function currentTriggerOnTimeMs()
    local v = tonumber(Controls.trigger_on_time_ms.String)
    if v == nil or v < 0 then
      return 0
    end
    return v
  end

  local function updateStatus(text)
    Controls.status_text.String = text
    Controls.active.Boolean = isPlaying
    -- Give the LED a distinct color per state so it's visually obvious
    -- whether the plugin is idle, actively playing, or "finishing" the
    -- minimum play time after an early release:
    --   Gray   = idle (not playing)
    --   Green  = playing normally (input still held / min time already met)
    --   Amber  = still playing ONLY to satisfy Minimum Play Time after
    --            an early release (input is no longer true)
    if not isPlaying then
      Controls.active.Color = { 90, 90, 90 } -- gray = idle
    elseif releaseRequested then
      Controls.active.Color = { 255, 165, 0 } -- amber = finishing min time
    else
      Controls.active.Color = { 0, 255, 0 } -- green = actively playing
    end
  end

  local function applyReverbMix()
    if not reverb then return end
    local mixPct = Controls.reverb_mix.Value or 0
    -- Most Q-SYS Reverb components expose a "mix" or "wet" style control
    -- (0-1 or 0-100 depending on the component). We try the common name
    -- "mix" first, scaled 0-1, then fall back to a direct percent control
    -- named "wet_dry" if present.
    local ok = pcall(function()
      reverb["mix"].Value = mixPct / 100
    end)
    if not ok then
      pcall(function()
        reverb["wet_dry"].Value = mixPct
      end)
    end
  end

  -- ------------------------------------------------------------------
  -- Typed Trigger Output: independent of the bell audio/minimum play
  -- time logic. On press, immediately sets the "on" value (Boolean
  -- true / Integer 1 / String "on" depending on Trigger Output Type),
  -- then automatically reverts to the "off" value after the configured
  -- On Time elapses - regardless of whether the button is still held.
  -- ------------------------------------------------------------------
  local function triggerOutputOnValue()
    local t = Controls.trigger_output_type.String
    if t == "Integer" then
      return "1"
    elseif t == "String" then
      return "on"
    else -- Boolean
      return "true"
    end
  end

  local function triggerOutputOffValue()
    local t = Controls.trigger_output_type.String
    if t == "Integer" then
      return "0"
    elseif t == "String" then
      return "off"
    else -- Boolean
      return "false"
    end
  end

  local function fireTriggerOutput()
    Controls.trigger_output.String = triggerOutputOnValue()
    DebugPrint("Trigger output ON (" .. Controls.trigger_output_type.String .. ")")

    triggerOutputTimer:Stop()
    local onMs = currentTriggerOnTimeMs()
    if onMs <= 0 then
      Controls.trigger_output.String = triggerOutputOffValue()
      return
    end

    triggerOutputTimer.EventHandler = function()
      Controls.trigger_output.String = triggerOutputOffValue()
      DebugPrint("Trigger output OFF (" .. Controls.trigger_output_type.String .. ")")
    end
    triggerOutputTimer:Start(onMs / 1000)
  end

  local function forceTriggerOutputOff()
    triggerOutputTimer:Stop()
    Controls.trigger_output.String = triggerOutputOffValue()
  end

  local function startPlayback()
    if not player then
      DebugPrint("Cannot start playback - bundled Player sub-component is unavailable.")
      return
    end

    local file = currentFileName()
    if file == nil or file == "" then
      DebugPrint("Cannot start playback - no file name resolved.")
      return
    end

    DebugPrint("Starting playback: " .. file)

    -- Configure the native Audio File Player: select file, force loop on
    -- (a bell can ring 15s+ so the source clip must repeat), then play.
    pcall(function() player["file.name"].String = file end)
    pcall(function() player["loop"].Boolean = true end)
    pcall(function() player["play"].Boolean = true end)

    isPlaying = true
    minTimeElapsed = false
    releaseRequested = false

    applyReverbMix()
    updateStatus("playing: " .. file)

    local minMs = currentMinPlayMs()
    DebugPrint("Minimum play time armed: " .. minMs .. " ms")
    minTimer:Stop()
    if minMs <= 0 then
      minTimeElapsed = true
    else
      minTimer.EventHandler = function()
        minTimeElapsed = true
        DebugPrint("Minimum play time elapsed (releaseRequested=" .. tostring(releaseRequested) .. ")")
        if releaseRequested then
          -- Input was released before the minimum time was up; now that
          -- the minimum has elapsed, actually stop playback.
          stopPlayback()
        end
      end
      minTimer:Start(minMs / 1000)
    end
  end

  function stopPlayback()
    if not isPlaying then return end

    if not minTimeElapsed then
      -- Still inside the minimum play window - defer the stop until the
      -- minimum timer fires (handled in startPlayback's EventHandler).
      releaseRequested = true
      DebugPrint("Release requested before minimum play time elapsed - deferring stop")
      updateStatus("finishing minimum play time...")
      return
    end

    DebugPrint("Stopping playback (minimum play time already satisfied)")

    if player then
      pcall(function() player["play"].Boolean = false end)
    end

    isPlaying = false
    releaseRequested = false
    minTimer:Stop()
    updateStatus("idle")
  end

  -- ------------------------------------------------------------------
  -- Event wiring
  -- ------------------------------------------------------------------
  -- "input" is a Momentary button: Controls.input.Boolean is true only
  -- while physically held down, and automatically goes false on release
  -- (Q-SYS handles this natively for Momentary buttons - no toggle state
  -- is retained), so press/release drive startPlayback()/stopPlayback()
  -- exactly like a physical momentary contact.
  Controls.input.EventHandler = function(ctrl)
    if ctrl.Boolean then
      if not isPlaying then
        startPlayback()
      end
      fireTriggerOutput()
    else
      stopPlayback()
    end
  end

  Controls.stop_now.EventHandler = function()
    -- Force-stop overrides the minimum play time guard entirely.
    minTimeElapsed = true
    releaseRequested = false
    stopPlayback()
    forceTriggerOutputOff()
  end

  Controls.reverb_mix.EventHandler = function()
    applyReverbMix()
  end

  Controls.sound_select.EventHandler = function()
    DebugPrint("Sound selection changed to: " .. tostring(Controls.sound_select.String))
  end

  updateStatus("idle")
  applyReverbMix()
  forceTriggerOutputOff()
  DebugPrint("PKE~Button-Bell initialized")
end
